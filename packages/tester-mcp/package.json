{
  "name": "@ctulib/tester-mcp",
  "version": "0.1.0",
  "description": "MCP bridge for CTULib exploratory and end-to-end QA testing",
  "private": true,
  "type": "module",
  "bin": {
    "ctulib-tester-mcp": "./src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:agents": "node scripts/install.mjs",
    "pack:local": "pnpm pack --pack-destination ./dist"
  },
  "files": ["src", "skills", "scripts", "README.md"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
