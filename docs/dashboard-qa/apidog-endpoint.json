{
  "name": "Dashboard - Thống kê vận hành thư viện",
  "type": "http",
  "method": "get",
  "path": "/api/v1/dashboard/stats",
  "folderId": 0,
  "status": "testing",
  "description": "UC19/SC11. Yêu cầu Bearer token của EMPLOYEE/ADMIN có quyền MANAGE_LOANS. Đồng bộ phiếu quá hạn trước khi tổng hợp số đầu sách lưu hành, tồn kho, độc giả, trạng thái mượn và tiền phạt.",
  "tags": ["dashboard", "qa", "MANAGE_LOANS"],
  "parameters": { "path": [], "query": [], "header": [], "cookie": [] },
  "responses": [
    {
      "name": "Thống kê thành công",
      "code": 200,
      "contentType": "json",
      "mediaType": "application/json",
      "description": "Trả về dữ liệu dashboard hiện tại.",
      "jsonSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "data": {
            "type": "object",
            "required": ["books", "readers", "loans", "penalties"],
            "properties": {
              "books": {
                "type": "object",
                "required": ["totalTitles", "totalCopies", "availableCopies", "outOfStockCount", "outOfStockList"],
                "properties": {
                  "totalTitles": { "type": "integer" },
                  "totalCopies": { "type": "integer" },
                  "availableCopies": { "type": "integer" },
                  "outOfStockCount": { "type": "integer" },
                  "outOfStockList": { "type": "array", "items": { "type": "object" } }
                }
              },
              "readers": { "type": "object", "properties": { "totalReaders": { "type": "integer" } } },
              "loans": { "type": "object", "properties": { "borrowingCount": { "type": "integer" }, "overdueCount": { "type": "integer" }, "pendingPenaltyCount": { "type": "integer" } } },
              "penalties": { "type": "object", "properties": { "unpaidPenalty": { "type": "number" }, "collectedPenalty": { "type": "number" }, "totalRevenue": { "type": "number" } } }
            }
          }
        }
      }
    },
    { "name": "Chưa đăng nhập", "code": 401, "contentType": "json", "mediaType": "application/json", "jsonSchema": { "type": "object", "properties": { "status": { "const": "error" }, "message": { "type": "string" }, "data": { "type": "null" } } } },
    { "name": "Thiếu quyền", "code": 403, "contentType": "json", "mediaType": "application/json", "jsonSchema": { "type": "object", "properties": { "status": { "const": "error" }, "message": { "type": "string" }, "data": { "type": "null" } } } }
  ]
}
