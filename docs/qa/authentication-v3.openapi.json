{
  "openapi": "3.0.3",
  "info": {
    "title": "CTULib authentication v3",
    "version": "3.0.0",
    "description": "Overlay chỉ cập nhật login/logout/refresh; không thay API nghiệp vụ khác."
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "Đăng ký, đăng nhập và đăng xuất."
    },
    {
      "name": "Books",
      "description": "Tra cứu và quản lý ấn phẩm."
    },
    {
      "name": "Loans",
      "description": "Đặt mượn, giao, nhận trả và hủy phiếu."
    },
    {
      "name": "Webhooks",
      "description": "Endpoint nội bộ nhận yêu cầu gửi thông báo; không phải callback gửi tới ứng dụng khách."
    },
    {
      "name": "Penalties",
      "description": "Tra cứu phiếu phạt và xác nhận đã thu đủ tiền mặt tại quầy; không tích hợp cổng thanh toán."
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Đăng nhập hệ thống",
        "description": "Hợp đồng backend hiện tại: HTTP 200, access JWT HS256 1800 giây với accountId/ctuIdentifier/role/iat/exp; refresh JWT qua cookie HttpOnly; SameSite=Lax; Path=/; Max-Age=604800. JSON chỉ chứa access token và account, không yêu cầu fullName/isActive. Chưa yêu cầu iss/aud/jti, opaque refresh, no-store hoặc Origin guard v3 trong suite hiện tại. Các yêu cầu này được giữ ở suite chờ triển khai riêng. CORS/browser đầy đủ cần kiểm thử thủ công riêng.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "ctuIdentifier": "B2404981",
                "password": "StrongPassword123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "headers": {
              "Set-Cookie": {
                "description": "refreshToken=<JWT>; HttpOnly; SameSite=Lax; Path=/; Max-Age=604800; Secure khi production HTTPS.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Đăng nhập thành công, trả về Token và Thông tin user",
                  "data": {
                    "token": "example.jwt.token",
                    "tokenType": "Bearer",
                    "expiresIn": 1800,
                    "user": {
                      "accountId": "64f1b2c3e4b0a1a2b3c4d5ea",
                      "ctuIdentifier": "B2404981",
                      "email": "reader@example.com",
                      "role": "READER"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Sai thông tin đăng nhập",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationErrorResponse"
                    }
                  ]
                },
                "example": {
                  "status": "error",
                  "message": "Sai thông tin đăng nhập",
                  "data": null
                }
              }
            },
            "headers": {}
          },
          "403": {
            "description": "Tài khoản đã bị khóa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Tài khoản đã bị khóa",
                  "data": null
                }
              }
            },
            "headers": {}
          },
          "503": {
            "description": "[Chờ triển khai/fault fixture] Dịch vụ xác thực tạm thời không khả dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Dịch vụ xác thực tạm thời không khả dụng",
                  "data": null
                }
              }
            },
            "headers": {}
          }
        },
        "operationId": "login",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Origin frontend để kiểm tra CORS; backend hiện tại chưa có Origin guard v3."
          }
        ],
        "x-apidog-status": "designing"
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Đăng xuất khỏi hệ thống",
        "description": "V3: Origin bắt buộc; dùng refreshToken cookie, không yêu cầu Bearer access JWT. Thu hồi cả sessionId kể cả token cookie đã rotate. Thiếu/sai/hết hạn/revoked cũng 200 idempotent. Xóa cookie Path=/api/v1/auth. Access JWT cũ còn dùng được đến exp. DB lỗi trả 503, không tuyên bố thành công. Chỉ ảnh hưởng phiên hiện tại.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Đăng xuất thành công",
            "headers": {
              "Set-Cookie": {
                "description": "refreshToken=<opaque 43 ký tự>; HttpOnly; SameSite=Strict; Path=/api/v1/auth; Max-Age bằng thời gian phiên còn lại; Secure trên HTTPS production; không Domain. Logout/401 xóa bằng Max-Age=0.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Đăng xuất thành công",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Origin không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Origin không hợp lệ",
                  "data": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Dịch vụ xác thực tạm thời không khả dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Dịch vụ xác thực tạm thời không khả dụng",
                  "data": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Dữ liệu không hợp lệ",
                  "data": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          }
        },
        "operationId": "logout",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Phải khớp CLIENT_URL; thiếu/null/khác trả 403. Apidog dùng {{clientOrigin}}."
          }
        ],
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              },
              "example": {}
            }
          }
        },
        "x-apidog-status": "designing"
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Làm mới access token và rotate refresh token",
        "operationId": "refreshTokens",
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Phải khớp CLIENT_URL; thiếu/null/khác trả 403. Apidog dùng {{clientOrigin}}."
          }
        ],
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              },
              "example": {}
            }
          }
        },
        "description": "Hợp đồng v3: refresh cookie opaque, hash SHA-256 lưu DB. Access JWT 900 giây; hạn phiên tuyệt đối 7 ngày không gia hạn. Rotation nguyên tử; replay thu hồi cùng sessionId. Refresh sau account LOCKED trả 403 và thu hồi mọi phiên account. Hai request cùng R0: một 200, một 401; cuối cùng cả phiên revoked. Không nhận refresh token từ JSON/query/Bearer. Origin guard trước body/token. 401 xóa cookie; 400/403 Origin/503 không thay cookie; 403 LOCKED xóa cookie. DB lỗi rollback, không cấp token.",
        "responses": {
          "200": {
            "description": "Làm mới token thành công",
            "headers": {
              "Set-Cookie": {
                "description": "refreshToken=<opaque 43 ký tự>; HttpOnly; SameSite=Strict; Path=/api/v1/auth; Max-Age bằng thời gian phiên còn lại; Secure trên HTTPS production; không Domain. Logout/401 xóa bằng Max-Age=0.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshSuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Làm mới token thành công",
                  "data": {
                    "token": "example.new.jwt",
                    "tokenType": "Bearer",
                    "expiresIn": 900
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Dữ liệu không hợp lệ",
                  "data": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Phiên đăng nhập không hợp lệ hoặc đã hết hạn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Phiên đăng nhập không hợp lệ hoặc đã hết hạn",
                  "data": null
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "refreshToken=<opaque 43 ký tự>; HttpOnly; SameSite=Strict; Path=/api/v1/auth; Max-Age bằng thời gian phiên còn lại; Secure trên HTTPS production; không Domain. Logout/401 xóa bằng Max-Age=0.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Origin không hợp lệ hoặc tài khoản bị khóa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Origin không hợp lệ hoặc tài khoản bị khóa",
                  "data": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "Set-Cookie": {
                "description": "Chỉ xóa cookie khi account LOCKED; lỗi Origin không thay cookie.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Dịch vụ xác thực tạm thời không khả dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "message": "Dịch vụ xác thực tạm thời không khả dụng",
                  "data": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          }
        },
        "x-apidog-status": "designing"
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Đăng ký và tự động đăng nhập",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công và cấp token cùng account",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie refreshToken HttpOnly; không trả refresh token trong JSON.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterSuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Đăng ký tài khoản thành công, trả về Token và Thông tin user",
                  "data": {
                    "token": "example.jwt.token",
                    "tokenType": "Bearer",
                    "expiresIn": 1800,
                    "user": {
                      "accountId": "64f1b2c3e4b0a1a2b3c4d5ea",
                      "ctuIdentifier": "B2404981",
                      "email": "reader@example.com",
                      "role": "READER"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Lỗi xác thực dữ liệu (Validation Error) hoặc Trùng lặp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "ctuIdentifier",
          "password"
        ],
        "properties": {
          "ctuIdentifier": {
            "type": "string",
            "example": "B2404981",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "StrongPassword123!",
            "minLength": 1,
            "writeOnly": true
          }
        }
      },
      "LoginSuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Đăng nhập thành công, trả về Token và Thông tin user"
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "description": "JWT truy cập. Gửi Authorization: Bearer <token>; giá trị ví dụ chỉ minh họa, không dùng để xác thực.",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "user": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string",
                    "example": "64f1b2c3e4b0a1a2b3c4d5e6"
                  },
                  "ctuIdentifier": {
                    "type": "string",
                    "example": "B2404981"
                  },
                  "role": {
                    "type": "string",
                    "description": "Ví dụ READER. Bộ UI dùng READER, EMPLOYEE, ADMIN; chưa khóa enum khi chưa đối chiếu backend. Quyền chức năng tách khỏi role.",
                    "example": "READER"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "reader@example.com"
                  },
                  "isActive": {
                    "type": "boolean",
                    "description": "Tùy chọn nếu backend trả trạng thái account."
                  }
                },
                "required": [
                  "accountId",
                  "ctuIdentifier",
                  "email",
                  "role"
                ],
                "description": "Thông tin account; không bắt buộc profile/fullName và không trả mật khẩu."
              },
              "tokenType": {
                "type": "string",
                "enum": [
                  "Bearer"
                ]
              },
              "expiresIn": {
                "type": "integer",
                "enum": [
                  1800
                ]
              }
            },
            "required": [
              "token",
              "tokenType",
              "expiresIn",
              "user"
            ]
          }
        },
        "required": [
          "status",
          "data",
          "message"
        ]
      },
      "RefreshSuccessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token",
              "tokenType",
              "expiresIn"
            ],
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "description": "Access JWT HS256, 900 giây; không lưu DB. Claims sub, role, iat, exp, iss=ctulib-api, aud=ctulib-web, jti."
              },
              "tokenType": {
                "type": "string",
                "enum": [
                  "Bearer"
                ]
              },
              "expiresIn": {
                "type": "integer",
                "enum": [
                  900
                ]
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "example": "Thông báo lỗi từ server (VD: Sai thông tin đăng nhập, Tài khoản bị khóa)"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "status",
          "data",
          "message"
        ],
        "description": "Lỗi nghiệp vụ hoặc xác thực. data là object chi tiết hoặc null; lỗi theo trường dùng ValidationErrorResponse."
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "Thao tác thành công"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "status",
          "data",
          "message"
        ],
        "description": "Phản hồi thao tác chung. data có thể null nếu thao tác không trả tài nguyên."
      },
      "RegisterSuccessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "enum": [
              "Đăng ký tài khoản thành công, trả về Token và Thông tin user"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token",
              "tokenType",
              "expiresIn",
              "user"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1,
                "description": "Access JWT được cấp ngay sau đăng ký; không phải refresh token."
              },
              "tokenType": {
                "type": "string",
                "enum": [
                  "Bearer"
                ]
              },
              "expiresIn": {
                "type": "integer",
                "enum": [
                  1800
                ]
              },
              "user": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accountId",
                  "ctuIdentifier",
                  "email",
                  "role"
                ],
                "properties": {
                  "accountId": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{24}$"
                  },
                  "ctuIdentifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "READER"
                    ]
                  },
